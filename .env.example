# Kopie tohoto souboru jako .env.local (gitignored) doplň reálné hodnoty.
# .env.example je TEMPLATE — nikdy neobsahuje reálná tajemství.

# Resend (server-only) — doručování kontaktních formulářů.
# Získáš v Resend dashboardu. NIKDY s prefixem NEXT_PUBLIC_.
RESEND_API_KEY=

# Povolený origin pro kontaktní Route Handler (origin check).
CONTACT_ALLOWED_ORIGIN=https://vevit.art

# Supabase — veřejné (bezpečné pro prohlížeč, chráněné RLS).
NEXT_PUBLIC_SUPABASE_URL=https://qbfwujnwpmyjjchzwwug.supabase.co
# Moderní publishable key (formát sb_publishable_...). Nahrazuje legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only (obejde RLS). Získáš v Supabase dashboardu (Project Settings → API).
# NIKDY s prefixem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=